<!-- HTML Modal Window -->
<div id="cntrModal" class="modal">
    <div class="modal-content">
        <span class="close-btn" onclick="closeVariantModal()">&times;</span>
        <h2>CNTR Manuscript Comparison</h2>
        <iframe id="cntrFrame" src="about:blank" width="100%" height="500px" style="border:none;"></iframe>
    </div>
</div>

<!-- Modal JavaScript Logic -->
<script>
function openVariantModal() {
    // 1. Grab text from the passage title box
    const passageElement = document.getElementById("passageTitle");
    const passageText = passageElement ? passageElement.innerText.trim().toLowerCase() : "";

    // 2. Book mapping for CNTR numeric IDs
    const books = {
        "matthew": 40, "mark": 41, "luke": 42, "john": 43, "acts": 44, "romans": 45,
        "1 corinthians": 46, "1cor": 46, "2 corinthians": 47, "2cor": 47,
        "galatians": 48, "gal": 48, "ephesians": 49, "eph": 49,
        "philippians": 50, "phil": 50, "colossians": 51, "col": 51,
        "1 thessalonians": 52, "1thess": 52, "2 thessalonians": 53, "2thess": 53,
        "1 timothy": 54, "1tim": 54, "2 timothy": 55, "2tim": 55,
        "titus": 56, "tit": 56, "philemon": 57, "phlm": 57,
        "hebrews": 58, "heb": 58, "james": 59, "jas": 59,
        "1 peter": 60, "1pet": 60, "2 peter": 61, "2pet": 61,
        "1 john": 62, "1jn": 62, "2 john": 63, "2jn": 63,
        "3 john": 64, "3jn": 64, "jude": 65, "revelation": 66, "rev": 66
    };

    let finalUrl = "https://greekcntr.org/collation/index.html";

    // 3. Extract book, chapter, and verse (e.g., "Colossians 1:5")
    const match = passageText.match(/^(([1-3]\s+)?[a-z]+)\s+(\d+)(?:[:.](\d+))?/);

    if (match) {
        const bookName = match[1].trim();
        const chapter = match[3].padStart(3, '0');
        const verse = (match[4] || '1').padStart(3, '0');
        const bookNum = books[bookName];

        if (bookNum) {
            finalUrl = `https://greekcntr.org/collation/index.html?v=${bookNum}${chapter}${verse}`;
        }
    }

    // 4. Update iframe source and open window
    document.getElementById("cntrFrame").src = finalUrl;
    document.getElementById("cntrModal").style.display = "block";
}

function closeVariantModal() {
    document.getElementById("cntrModal").style.display = "none";
    document.getElementById("cntrFrame").src = "about:blank";
}
// Creates a new custom color button for thematic highlighting
function createNewTheme() {
    // 1. Read the name and color the user chose
    const themeName = document.getElementById("newThemeName").value.trim();
    const themeColor = document.getElementById("newThemeColor").value;

    // 2. Stop if the text box is empty
    if (themeName === "") {
        alert("Please type a theme name before adding a label.");
        return;
    }

    // 3. Build a brand new button on the screen
    const themeBtn = document.createElement("button");
    themeBtn.innerText = themeName;
    themeBtn.style.backgroundColor = themeColor;
    themeBtn.style.padding = "6px 14px";
    themeBtn.style.border = "1px solid rgba(0,0,0,0.2)";
    themeBtn.style.borderRadius = "20px";
    themeBtn.style.cursor = "pointer";
    themeBtn.style.fontWeight = "bold";
    themeBtn.style.color = "#000"; // Keeps text readable

    // 4. Program the button to highlight whatever text is currently selected
    themeBtn.onclick = function() {
        document.execCommand("backColor", false, themeColor);
    };

    // 5. Place the button on the screen and clear the text box for the next one
    document.getElementById("customThemes").appendChild(themeBtn);
    document.getElementById("newThemeName").value = "";
}

// Creates a new custom color button for thematic highlighting
function createNewTheme() {
    const themeName = document.getElementById("newThemeName").value.trim();
    const themeColor = document.getElementById("newThemeColor").value;

    if (themeName === "") {
        alert("Please type a theme name before adding a label.");
        return;
    }

    const themeBtn = document.createElement("button");
    themeBtn.innerText = themeName;
    themeBtn.style.backgroundColor = themeColor;
    themeBtn.style.padding = "6px 14px";
    themeBtn.style.border = "1px solid rgba(0,0,0,0.2)";
    themeBtn.style.borderRadius = "20px";
    themeBtn.style.cursor = "pointer";
    themeBtn.style.fontWeight = "bold";
    themeBtn.style.color = "#000";

    // Forces the cursor to stay on your text when clicking the color label
    themeBtn.onmousedown = function(event) {
        event.preventDefault();
    };

    themeBtn.onclick = function() {
        document.execCommand("backColor", false, themeColor);
    };

    document.getElementById("customThemes").appendChild(themeBtn);
    document.getElementById("newThemeName").value = "";
}
// Intercepts the Tab key inside the workspace to indent text instead of changing focus
function handleTabKey(event) {
    if (event.key === 'Tab') {
        event.preventDefault(); // Stops the browser from leaving the text box
        
        if (event.shiftKey) {
            // Shift + Tab moves it backward
            document.execCommand('outdent', false, null);
        } else {
            // Tab moves it forward
            document.execCommand('indent', false, null);
        }
    }
}

	// Applies a right-aligned grammatical badge from the dropdown selector
function applySyntaxBadge(selectElement) {
    const labelText = selectElement.value;
    if (!labelText) return;

    const sel = window.getSelection();
    if (!sel.rangeCount) {
        selectElement.value = ""; // Reset dropdown
        return;
    }

    // Build the right-aligned badge
    const badge = document.createElement("span");
    badge.contentEditable = "false";
    badge.innerText = labelText.toUpperCase();
    badge.title = "Click to remove this badge";
    
    badge.style.cssText = `
        float: right;
        background-color: #e2e8f0;
        color: #334155;
        font-size: 0.7em;
        font-weight: bold;
        padding: 2px 6px;
        border-radius: 4px;
        border: 1px solid #cbd5e1;
        margin-left: 15px;
        cursor: pointer;
        user-select: none;
    `;

    // Click to delete
    badge.onclick = function() {
        this.remove();
    };

    // Insert into cursor line
    const range = sel.getRangeAt(0);
    range.insertNode(badge);

    // Reset dropdown back to default placeholder
    selectElement.value = "";
}

// Toggles horizontal expansion for the phrasing canvas
function toggleCanvasWidth(btn) {
    const canvas = document.getElementById("observationWorkspace");
    canvas.classList.toggle("expanded-canvas");

    if (canvas.classList.contains("expanded-canvas")) {
        btn.innerText = "↔ Reset Width";
        btn.style.backgroundColor = "#cbd5e1";
    } else {
        btn.innerText = "↔ Expand Canvas";
        btn.style.backgroundColor = "";
    }
}

// Toggles dashed line + arrow for clauses that modify text BELOW them
function toggleUpwardFlow() {
    const sel = window.getSelection();
    if (!sel.rangeCount) return;

    let node = sel.anchorNode;
    
    // Walk up the DOM tree to find the active blockquote
    while (node && node.id !== "observationWorkspace") {
        if (node.tagName === "BLOCKQUOTE") {
            node.classList.toggle("upward-flow");
            return;
        }
        node = node.parentNode;
    }
}

